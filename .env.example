# Copier ce fichier en « .env » et le remplir. Le fichier .env n'est jamais envoyé sur GitHub (.gitignore).
# Mise en route complète : MISE-EN-ROUTE.md

# --- Site (variables lues par Vite : publiques, elles finissent dans le code envoyé aux visiteurs) ---
# Supabase → Project Settings → API : « Project URL » et clé « anon » / « publishable »
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Stripe → Développeurs → Clés API : clé publiable (pk_test_… en test)
VITE_STRIPE_PUBLISHABLE_KEY=
# Facultatif, en local : fonctions serveur simulées par dev-server.js au lieu de Supabase
# VITE_API_BASE=http://localhost:3001

# --- dev-server.js uniquement (secrets : jamais de préfixe VITE_) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...      (affiché par « stripe listen »)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...        (Project Settings → API : clé « service_role » / « secret »)
# ANTHROPIC_API_KEY=...                (facultatif : conseiller IA en local)
